{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Foryooru",
  "version": "../package.json",
  "identifier": "com.j.foryooru",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Foryooru",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["gstreamer1.0-plugins-good", "gstreamer1.0-plugins-bad", "gstreamer1.0-libav"]
      },
      "rpm": {
        "depends": ["gstreamer1-plugins-good", "gstreamer1-plugins-bad-free", "gstreamer1-plugin-openh264"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwMTU0RjgwNzBBOTA0Q0IKUldUTEJLbHdnRThWb09mQWVuTUpsRWtlaW5ONHNNQ2FaZ05NVDhBdTlKemFkY1lXeDluZ2I4L3kK",
      "endpoints": ["https://github.com/ikaikahub/foryooru/releases/latest/download/latest.json"]
    }
  }
}
